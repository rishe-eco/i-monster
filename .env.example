# The server reads these from its process environment (lib/env.ts); nothing
# loads a .env file. Locally, export them in the shell, or keep them in .env
# and run `node --env-file=.env --import tsx server.ts`. .env is never
# committed (it is in .gitignore).
# All values below are optional; these are the defaults.

# Port the server listens on.
PORT=4100

# SQLite file. The directory is created if it is missing.
DB_PATH=.tmp/dev.db

# The founder's timezone, for every date the site shows (PD-9).
# Asia/Tehran, confirmed by the founder (P0-5, 2026-10-11).
SITE_TZ=Asia/Tehran

# 1 asks search engines not to index the site (X-Robots-Tag and robots.txt).
# Unset it at launch.
PRELAUNCH=

# 1 adds the test-only clock route. The server refuses to boot with it
# when NODE_ENV=production.
E2E_CLOCK=

# The origin the site is served from, with no path. Passkeys are bound to its
# hostname, and every admin POST must carry it as its Origin header (PD-14).
# Defaults to https://imnstr.com when NODE_ENV=production, and to
# http://localhost:<PORT> otherwise, so production needs no line for it.
ORIGIN=

# development (default), test or production.
NODE_ENV=development

# The founder's own links, shown on /contact. Optional: a link whose variable
# is unset (or not valid) is simply not shown, and the form still works. The
# real values live in the server's .env only, never in this repo. Handles are
# written without the @. A value that isn't valid is dropped, with a warning
# at boot that names the variable.
CONTACT_EMAIL=
CONTACT_TELEGRAM=
CONTACT_INSTAGRAM=
