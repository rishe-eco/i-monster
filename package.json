{
  "name": "imnstr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IMNSTR.com, a bilingual personal site",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "seed-entry": "tsx scripts/seed-entry.ts",
    "check": "tsc --noEmit && tsc --noEmit -p admin && eslint .",
    "backup": "tsx scripts/backup.ts",
    "setup-token": "tsx scripts/setup-token.ts",
    "build": "vite build --config admin/vite.config.ts",
    "report": "tsx scripts/report.ts",
    "reset-content": "tsx scripts/reset-content.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "preact": "^11.0.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
